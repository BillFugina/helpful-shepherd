# Copy to .env for local dev. Never commit .env (it's gitignored).
# Demo only: fake data, personal free-tier accounts. Real data needs
# theater-owned accounts and fresh secrets first (see the build plan).

# Postgres connection string.
#   Local:  postgres://postgres:postgres@localhost:5432/theatre
#   Neon:   postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# 32 random bytes, base64url. Encrypts DOB and travel IDs in the database.
# Same command as above. Changing it makes existing encrypted values unreadable.
FIELD_ENCRYPTION_KEY=

# Optional. Public origin of the app. Defaults to the Vercel deployment URL,
# or http://localhost:5173 locally.
# BETTER_AUTH_URL=http://localhost:5173

# Optional, for npm run db:seed. Without a password, one is generated and printed.
# SEED_CM_EMAIL=company.manager@example.com
# SEED_FINANCE_EMAIL=finance@example.com
# SEED_DEMO_PASSWORD=

# Optional. "off" turns off the public read-only guest demo (Try the demo, /demo).
# DEMO_GUEST=on

# Optional: reminder emails for missing paperwork, sent through Resend.
# With no key (or EMAIL_DELIVERY=log), nothing is sent: the app shows the email to copy.
# allowlist sends only to EMAIL_ALLOWLIST; live sends to real people (demo people still only to the allowlist).
# RESEND_API_KEY=
# EMAIL_FROM="Theatre Raleigh <reminders@your-verified-domain>"
# EMAIL_DELIVERY=log
# EMAIL_ALLOWLIST=you@example.org
